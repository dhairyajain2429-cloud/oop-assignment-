#include <iostream>
using namespace std;

class Employee {
public:
    string name;
    int id;

    void display() {
        cout << "Name: " << name << endl;
        cout << "ID: " << id << endl;
    }
};

int main() {
    Employee e;

    e.name = "Rahul";
    e.id = 101;

    e.display();

    return 0;
}